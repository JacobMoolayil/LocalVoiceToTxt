<Window x:Class="LocalVoice.App.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalVoice" Height="250" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    
    <Border Background="#202020" CornerRadius="12" BorderBrush="#3A3A3A" BorderThickness="2" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" ShadowDepth="5"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FF4444" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Text="Listening..." Foreground="#CCCCCC" FontWeight="Bold" FontSize="14" />
                <TextBlock Text="GPU: RTX 3050" Foreground="#888888" FontSize="12" Margin="150,2,0,0" HorizontalAlignment="Right" />
            </StackPanel>
            
            <!-- Transcription Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="CommittedTextBlock" TextWrapping="Wrap" Foreground="#FFFFFF" FontSize="16" Margin="0,0,0,5" />
                    <TextBlock x:Name="InterimTextBlock" TextWrapping="Wrap" Foreground="#AAAAAA" FontStyle="Italic" FontSize="16" />
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer Controls -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnClear" Content="Clear" Width="60" Margin="0,0,10,0" Padding="5" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnClear_Click"/>
                <Button x:Name="BtnCopy" Content="Copy All" Width="70" Margin="0,0,10,0" Padding="5" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnCopy_Click"/>
                <Button x:Name="BtnStop" Content="Stop" Width="60" Padding="5" Background="#883333" Foreground="White" BorderThickness="0" Click="BtnStop_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
