<Window x:Class="LocalVoice.App.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalVoice" Height="300" Width="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    
    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#3F3F46" BorderThickness="1.5" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.7" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Listening..." Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="14" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="GPU: RTX 3050 (CUDA FP16)" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" />
            </DockPanel>
            
            <!-- Transcription Content Area -->
            <Border Grid.Row="1" Background="#141414" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="CommittedTextBlock" TextWrapping="Wrap" Foreground="#F9FAFB" FontSize="15" LineHeight="22" Margin="0,0,0,4" />
                        <TextBlock x:Name="InterimTextBlock" TextWrapping="Wrap" Foreground="#9CA3AF" FontStyle="Italic" FontSize="15" LineHeight="22" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Footer Controls -->
            <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="HotKey: Ctrl+Shift+Space" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnClear" Content="Clear" Width="64" Height="28" Margin="0,0,8,0" Background="#27272A" Foreground="#E4E4E7" BorderThickness="0" Cursor="Hand" Click="BtnClear_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnCopy" Content="Copy All" Width="72" Height="28" Margin="0,0,8,0" Background="#2563EB" Foreground="White" FontWeight="Medium" BorderThickness="0" Cursor="Hand" Click="BtnCopy_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnStop" Content="Hide" Width="60" Height="28" Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0" Cursor="Hand" Click="BtnStop_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
