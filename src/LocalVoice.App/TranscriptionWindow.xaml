<Window x:Class="LocalVoice.App.TranscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalVoice" Height="380" Width="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="CenterScreen">
    
    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#3F3F46" BorderThickness="1.5" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" Opacity="0.7" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <DockPanel LastChildFill="False">
                    <!-- Left: On/Off Toggle Button + Visual Listening Status -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- On/Off Button -->
                        <Button x:Name="BtnToggleListening" Width="76" Height="28" Margin="0,0,12,0"
                                Background="#27272A" BorderBrush="#4B5563" BorderThickness="1.5"
                                Cursor="Hand" Click="BtnToggleListening_Click"
                                ToolTip="Click to toggle listening on/off (or press Ctrl+Shift+Space)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="ToggleBtnDot" Width="8" Height="8" Fill="#9CA3AF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="ToggleBtnText" Text="OFF" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Status Indicator (Dot + Text) -->
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#6B7280" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="OFF (Not Listening)" Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Active Whisper Model & Hardware Info -->
                    <Border x:Name="WhisperModelBorder" DockPanel.Dock="Right" Background="#18181B" CornerRadius="6" 
                            BorderBrush="#27272A" BorderThickness="1" Padding="8,4" VerticalAlignment="Center"
                            ToolTip="Active Whisper Model &amp; Hardware Device">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Whisper: " Foreground="#9CA3AF" FontSize="11" FontWeight="Medium"/>
                            <TextBlock x:Name="WhisperModelText" Text="small" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="  |  " Foreground="#3F3F46" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HardwareDeviceText" Text="GPU: RTX 3050 (CUDA FP16)" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Sleek Indeterminate Loading Indicator -->
                <ProgressBar x:Name="LoadingProgressBar" VerticalAlignment="Bottom" Height="2"
                             IsIndeterminate="True" Foreground="#3B82F6" Background="Transparent" 
                             BorderThickness="0" Margin="0,0,0,-6" Visibility="Visible"/>
            </Grid>
            
            <!-- Transcription Content Area -->
            <Border Grid.Row="1" Background="#141414" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="12">
                <Grid>
                    <ScrollViewer x:Name="TranscriptionScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBox x:Name="CommittedTextBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     Foreground="#F9FAFB"
                                     BorderThickness="0"
                                     FontSize="15"
                                     Padding="0"
                                     Margin="0,0,0,4"
                                     Cursor="IBeam"
                                     IsReadOnlyCaretVisible="False"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     SelectionBrush="#2563EB"
                                     SelectionOpacity="0.5"
                                     FocusVisualStyle="{x:Null}"
                                     SelectionChanged="CommittedTextBox_SelectionChanged"
                                     PreviewMouseWheel="CommittedTextBox_PreviewMouseWheel">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                                <TextBox.ContextMenu>
                                    <ContextMenu Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1">
                                        <ContextMenu.Resources>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="#F9FAFB"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="8,4"/>
                                            </Style>
                                        </ContextMenu.Resources>
                                        <MenuItem Command="ApplicationCommands.Copy" Header="Copy" />
                                        <MenuItem Command="ApplicationCommands.SelectAll" Header="Select All" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                            <TextBlock x:Name="InterimTextBlock" TextWrapping="Wrap" Foreground="#9CA3AF" FontStyle="Italic" FontSize="15" LineHeight="22" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHintTextBlock" Text="Dictation is OFF. Press Ctrl+Shift+Space or click ON to start." 
                               Foreground="#4B5563" FontStyle="Italic" FontSize="13" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               IsHitTestVisible="False" Visibility="Visible"/>
                </Grid>
            </Border>

            <!-- Current Microphone Device Label -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="🎙 Mic:" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="CurrentMicText" Text="No device" Foreground="#D1D5DB" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Footer Controls -->
            <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSettings" Width="84" Height="28" Margin="0,0,12,0"
                            Background="#27272A" Foreground="#E4E4E7" BorderThickness="0" Cursor="Hand" Click="BtnSettings_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="HotKey: Ctrl+Shift+Space" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnClear" Content="Clear" Width="64" Height="28" Margin="0,0,8,0" Background="#27272A" Foreground="#E4E4E7" BorderThickness="0" Cursor="Hand" Click="BtnClear_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnCopy" Content="Copy All" Width="72" Height="28" Margin="0,0,8,0" Background="#2563EB" Foreground="White" FontWeight="Medium" BorderThickness="0" Cursor="Hand" Click="BtnCopy_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnStop" Content="Hide" Width="60" Height="28" Background="#3F3F46" Foreground="#E4E4E7" BorderThickness="0" Cursor="Hand" Click="BtnStop_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- Settings Flyout Popup -->
            <Popup x:Name="SettingsPopup" Placement="Top" PlacementTarget="{Binding ElementName=BtnSettings}"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#1E1E1E" CornerRadius="8" BorderBrush="#3F3F46" BorderThickness="1.5" Padding="14" Margin="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="15" Opacity="0.5" ShadowDepth="3"/>
                    </Border.Effect>
                    <StackPanel Width="260">
                        <!-- Microphone Selector -->
                        <TextBlock Text="MICROPHONE" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="MicComboBox" Background="#27272A" Foreground="#111827" FontSize="11" Height="26"
                                  SelectionChanged="MicComboBox_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                        <!-- Separator -->
                        <Border Height="1" Background="#3F3F46" Margin="0,12,0,12"/>

                        <!-- Settings Checkboxes -->
                        <TextBlock Text="OPTIONS" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkStartup" Content="Start with Windows" Foreground="#D1D5DB" FontSize="11" 
                                  VerticalContentAlignment="Center" Cursor="Hand" Margin="0,0,0,8"
                                  Checked="ChkStartup_Changed" Unchecked="ChkStartup_Changed"/>
                        <CheckBox x:Name="ChkTerminal" Content="Show Terminal" Foreground="#D1D5DB" FontSize="11" 
                                  VerticalContentAlignment="Center" Cursor="Hand"
                                  Checked="ChkTerminal_Changed" Unchecked="ChkTerminal_Changed"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
